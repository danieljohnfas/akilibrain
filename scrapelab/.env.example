PORT=4000
# one key per consuming project: name:key,name:key
SCRAPELAB_KEYS=akilihub:change-me,tiketichap:change-me,getproducts:change-me,vault:change-me
# self-hosted Firecrawl (cd firecrawl && docker compose up); leave empty for plain HTTP only
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=
MIN_DOMAIN_INTERVAL_MS=2000
BLOCKLIST=glassdoor.com,youtube.com,tiktok.com
